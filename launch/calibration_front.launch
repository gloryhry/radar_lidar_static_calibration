<launch>

    <node pkg="radar_lidar_static_calibration" type="radar_lidar_static_calibration_node" name="static_calibration" output="screen" >
        <param name="lidar_topic" value="/slam_lidar/points" />
        <param name="radar_topic" value="/ars620_front/rdi_points" />
        <param name="target_frame" value="base_link" />
    </node>

    <node pkg="tf2_ros"
      type="static_transform_publisher"
      name="base_link_to_hesai_lidar"
      args="0.33767 0.0 0.08134 0.5 0.5 0.5 0.5 base_link hesai_lidar" />
</launch>